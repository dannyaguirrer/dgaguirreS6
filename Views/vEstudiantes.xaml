<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dgaguirreS6.Views.vEstudiantes"
             Title="vEstudiantes">
    <VerticalStackLayout>
        <Label 
            Text="Semana 6: Servicios web -Estudiantes"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontSize="20"/>
        <Grid ColumnDefinitions="*,*,*,*" Margin="20,0" BackgroundColor="Yellow">
            <Label Grid.Column="0" Text="Codigo" FontAttributes="Bold" Padding="5"/>
            <Label Grid.Column="1" Text="Nombre" FontAttributes="Bold" Padding="5"/>
            <Label Grid.Column="2" Text="Apellido" FontAttributes="Bold" Padding="5"/>
            <Label Grid.Column="3" Text="Edad" FontAttributes="Bold" Padding="5"/>
        </Grid>
        <ListView
            x:Name="lvEstudiantes"
            Margin="20"
            HasUnevenRows="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Label Grid.Column="0" Text="{Binding codigo}" FontSize="16" Padding="5"/>
                            <Label Grid.Column="1" Text="{Binding nombre}" FontSize="16" Padding="5"/>
                            <Label Grid.Column="2" Text="{Binding apellido}" FontSize="16" Padding="5"/>
                            <Label Grid.Column="3" Text="{Binding edad}" FontSize="16" Padding="5"/>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>